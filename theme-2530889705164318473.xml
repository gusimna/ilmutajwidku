    <script type='text/javascript'>
        function copyPrompt() {
            var title = document.getElementById(&quot;inputTitle&quot;).value || &quot;Seseorang yang butuh didengarkan&quot;;
            var notes = document.getElementById(&quot;inputNotes&quot;).value || &quot;Hanya ingin berbagi apa yang dirasakan.&quot;;
            
            var selectedLang = document.querySelector(&#39;input[name=&quot;lang&quot;]:checked&#39;).value;
            var template = (selectedLang === &#39;id&#39;) ? 
                           document.getElementById(&quot;templateID&quot;).innerText : 
                           document.getElementById(&quot;templateEN&quot;).innerText;
            
            var finalPrompt = template.replace(&quot;[USER_TITLE]&quot;, title).replace(&quot;[USER_NOTES]&quot;, notes);
            
            var tempElem = document.createElement(&quot;textarea&quot;);
            tempElem.value = finalPrompt;
            document.body.appendChild(tempElem);
            tempElem.select();
            document.execCommand(&quot;copy&quot;);
            document.body.removeChild(tempElem);
            
            alert(&quot;🌿 Prompt Empati (&quot; + (selectedLang === &#39;id&#39; ? &#39;Indonesia&#39; : &#39;English&#39;) + &quot;) telah disalin. Semoga harimu lebih tenang.&quot;);
        }
    </script>
